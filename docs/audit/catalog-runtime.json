{
  "tools": [
    {
      "id": "move",
      "name": "移动 / 变换",
      "group": "move",
      "shortcut": "V",
      "defaults": {
        "snap": true,
        "transformAll": false,
        "showControls": true
      },
      "specs": [
        {
          "key": "snap",
          "label": "自动对齐",
          "type": "boolean"
        },
        {
          "key": "transformAll",
          "label": "变换所有图层",
          "type": "boolean"
        },
        {
          "key": "showControls",
          "label": "显示变换控件",
          "type": "boolean"
        }
      ],
      "handlers": [
        "onDown",
        "onMove",
        "onUp",
        "onKeyDown"
      ]
    },
    {
      "id": "marquee",
      "name": "矩形框选",
      "group": "select",
      "shortcut": "M",
      "defaults": {
        "shape": "rect",
        "feather": 0,
        "antialias": true
      },
      "specs": [
        {
          "key": "shape",
          "label": "形状",
          "type": "select",
          "options": [
            {
              "value": "rect",
              "label": "矩形"
            },
            {
              "value": "ellipse",
              "label": "椭圆"
            }
          ]
        },
        {
          "key": "feather",
          "label": "羽化",
          "type": "number",
          "min": 0,
          "max": 250,
          "step": 0.5,
          "unit": "px"
        },
        {
          "key": "antialias",
          "label": "消除锯齿",
          "type": "boolean"
        }
      ],
      "handlers": [
        "onDown",
        "onMove",
        "onUp"
      ]
    },
    {
      "id": "lasso",
